
# Application
APP_ENV=development
APP_NAME=aegis-agent-runtime
LOG_LEVEL=INFO

# Infrastructure
DATABASE_URL=postgresql+asyncpg://aegis:aegis_dev_only@localhost:5432/aegis
REDIS_URL=redis://localhost:6379/0

# Temporal
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=aegis-agent-tasks

# Model provider
MODEL_PROVIDER=litellm
MODEL_TEMPERATURE=0.2
MODEL_TIMEOUT_SECONDS=60
MODEL_MAX_TOKENS=2048

# LiteLLM
LITELLM_MODEL=openai/gpt-4o-mini
LITELLM_API_KEY=

# Complexity-based model routing
SIMPLE_TASK_MODEL=openai/gpt-4o-mini
MODERATE_TASK_MODEL=openai/gpt-4o
COMPLEX_TASK_MODEL=openai/gpt-4o

# Model retry configuration
MODEL_RETRY_MAX_ATTEMPTS=3
MODEL_RETRY_INITIAL_DELAY_SECONDS=0.5
MODEL_RETRY_MAX_DELAY_SECONDS=8
MODEL_RETRY_EXPONENTIAL_BASE=2
MODEL_RETRY_JITTER=true
